{
    "Lua.workspace.library": ["${3rd}/love2d/library"],

    "Lua.diagnostics.disable": [],
    "Lua.diagnostics.globals": ["_ENV"],
    "Lua.runtime.version": "Lua 5.5",
    "Lua.workspace.checkThirdParty": false,
    "Lua.diagnostics.enable": true,

    /* --- LuaLS Hint Settings --- */
    "Lua.hint.enable": false,
    "Lua.hint.setType": true,
    "Lua.hint.paramName": "Disable",
    "Lua.hint.paramType": false,

    "cmake.cmakePath": "/opt/homebrew/bin/cmake",
    "pixelbyte.love2d.path": "C:/Program Files/LOVE/love.exe"
}